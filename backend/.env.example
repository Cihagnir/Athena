# .env olarak kopyala ve doldur. .env repoya girmez.

# "bugün/yarın" hesabının yapılacağı saat dilimi
TZ=Europe/Istanbul
PB_PORT=8090

# Admin UI (http://127.0.0.1:8090/_/) hesabı — her açılışta upsert edilir
PB_SUPERUSER_EMAIL=admin@task-tracker.local
PB_SUPERUSER_PASSWORD=

# Uygulamaların giriş yaptığı tek kullanıcı — yoksa açılışta oluşturulur
TT_USER_EMAIL=me@task-tracker.local
TT_USER_PASSWORD=
