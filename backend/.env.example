# .env olarak kopyala ve doldur. .env repoya girmez.

# "bugün/yarın" hesabının yapılacağı saat dilimi
TZ=Europe/Istanbul
PB_PORT=8090
# Verinin duracağı yer. Boş = Docker'ın adlandırılmış volume'u (yerel geliştirme).
# Sunucuda mutlak bir klasör: PB_DATA=/home/<kullanıcı>/task-tracker/data
# PB_DATA=

# Admin UI (http://127.0.0.1:8090/_/) hesabı — her açılışta upsert edilir
PB_SUPERUSER_EMAIL=admin@task-tracker.local
PB_SUPERUSER_PASSWORD=

# API anahtarları (virgülle ayrılmış; cihaz başına bir tane önerilir). Doluysa Cloudflare
# Tunnel üzerinden gelen her istek `X-API-Key` başlığında bunlardan birini taşımalıdır.
# Üretmek için: openssl rand -hex 32
TT_API_KEYS=
# 1: internete açık kurulum — hız sınırlayıcı + Cloudflare'den gerçek istemci IP'si
TT_PUBLIC=

# Uygulamaların giriş yaptığı tek kullanıcı — yoksa açılışta oluşturulur
TT_USER_EMAIL=me@task-tracker.local
TT_USER_PASSWORD=
